# Frontend .dockerignore

# Dependências — instaladas dentro do Docker
node_modules/

# Artefatos de build — gerados dentro do Docker
dist/
out-tsc/
.angular/

# Arquivos de IDE
.idea/
.vscode/

# Arquivos do sistema
.DS_Store

# Logs e arquivos temporários
*.log
npm-debug.log*
yarn-debug.log*

# Configurações de teste (não necessárias na imagem de produção)
karma.conf.js
