# =============================================================================
# .env.example — Variáveis de ambiente do projeto
# =============================================================================
# INSTRUÇÃO: copie este arquivo para .env e preencha os valores reais.
#   cp .env.example .env
#
# O arquivo .env está no .gitignore — NUNCA commite segredos reais.
# =============================================================================

# --- Auth Service (microserviços) ---
# Segredo JWT usado para assinar os tokens. Use uma string com 32+ caracteres.
JWT_SECRET=microservicos-chave-secreta-super-segura-32bytes!!

# Tempo de expiração do token em milissegundos (padrão: 1 hora)
JWT_EXPIRATION=3600000
